{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "integrate-dropbox/media-player",
    "version": "1.0.0",
    "title": "Media Player",
    "category": "integrate-dropbox",
    "icon": "format-gallery",
    "description": "Display files from Dropbox as a media player",
    "keywords": ["media player", "Dropbox", "files"],
    "textdomain": "integrate-dropbox",
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "attributes": {
        "id": {
            "type": "number"
        },
        "type": {
            "type": "string",
            "default": "media-player"
        }
    },
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": ["file:../../../../assets/css/common.css", "file:../../../../assets/plugins/ccplayer/ccplayer.css"]
}
